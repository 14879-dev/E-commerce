# ============================================================
# Peshawari Chappal Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

PORT=5000

# MongoDB Atlas URI — paste your connection string here
# Leave empty to use in-memory data store (works without MongoDB)
MONGO_URI=

# Admin Panel Credentials
ADMIN_USERNAME=peshawari
ADMIN_PASSWORD=Admin@123

# JWT Secret Key — change this to a long random string in production!
JWT_SECRET=peshawari-chappal-jwt-secret-2026-change-me

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
